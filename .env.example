# Google Web OAuth (Confidential Web Application Client)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
REDIRECT_URI=http://localhost:8501
STATE_SECRET=your-random-32-character-secret-string

# Supabase persistence (Server-side service key only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# Groq LLM API Keys (if GROQ_API_KEY_DRAFT missing, uses GROQ_API_KEY_CLASSIFY)
GROQ_API_KEY_CLASSIFY=gsk_your_groq_api_key_here
GROQ_API_KEY_DRAFT=gsk_your_groq_api_key_here

# Model Selection (Different models for separate rate limits and roles)
CLASSIFIER_MODEL=llama-3.3-70b-versatile
VERIFIER_MODEL=mixtral-8x7b-32768
DRAFTER_MODEL=llama-3.1-8b-instant

# Token-aware rate limiting (Tokens Per Minute per model)
CLASSIFIER_TPM=8000
VERIFIER_TPM=8000
DRAFTER_TPM=8000
